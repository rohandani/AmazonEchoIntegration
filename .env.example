# Environment variables template for Alexa Morning Briefing Skill
# Copy this file to .env and fill in your actual API keys

# OpenWeatherMap API Key (Free tier: 1,000 calls/day)
# Get from: https://openweathermap.org/api
OWM_API_KEY=your_openweathermap_api_key_here

# Groq API Key (Free tier: 14,400 requests/day)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Free tier: 1,500 requests/day)
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# User Configuration
# Your city for weather data (e.g., "Vancouver,CA" or "New York,US")
USER_CITY=your_city_here

# Set to "true" if you have school-age children for context-aware briefings
HAS_SCHOOL_KIDS=false